# Copy to backend/.env and fill in. Never commit the real .env.
# Get the key from https://resend.com/api-keys (free tier: 3,000 emails/month).
RESEND_API_KEY=re_your_resend_api_key_here

# The inbox that should receive contact-form messages.
CONTACT_TO_EMAIL=yashgawande0905@gmail.com

# Resend's shared sender works with zero DNS setup, but it can ONLY deliver to
# the email address that owns the Resend account. Once you verify your own
# domain in Resend, change this to e.g. "Yash Gawande <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Comma-separated origins allowed to call the API. Leave as * for local dev.
ALLOWED_ORIGINS=*
